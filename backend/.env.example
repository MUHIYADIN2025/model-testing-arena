# --- Ollama (local models, free) ---
OLLAMA_BASE_URL=http://localhost:11434
# Comma-separated list of Ollama model names to expose in the arena.
# Must already be pulled: `ollama pull llama3.1`, `ollama pull mistral`, etc.
OLLAMA_MODELS=llama3.1,mistral,phi3

# --- OpenAI (optional, paid — for comparing local vs. cloud models) ---
OPENAI_API_KEY=
OPENAI_MODELS=gpt-4o-mini

# --- Judge model (used to auto-score responses on a rubric) ---
# Set to "none" to disable auto-judging and rely only on user votes.
JUDGE_PROVIDER=ollama
JUDGE_MODEL=llama3.1

# --- Cost estimation (USD per 1K tokens) — extend as needed ---
# Local Ollama models are always $0 (self-hosted, no per-token billing).
OPENAI_GPT4O_MINI_INPUT_COST=0.00015
OPENAI_GPT4O_MINI_OUTPUT_COST=0.0006

# --- App ---
APP_ENV=development
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
DATABASE_URL=sqlite:///./arena.db
BATTLE_TIMEOUT_SECONDS=300
